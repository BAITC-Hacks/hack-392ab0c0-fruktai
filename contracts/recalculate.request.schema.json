{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fruktai.local/contracts/recalculate.request.schema.json",
  "title": "FruktAI recalculation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset"],
  "properties": {
    "dataset": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "overrides": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/override" }
    }
  },
  "$defs": {
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku"],
      "anyOf": [
        { "required": ["on_hand"] },
        { "required": ["in_transit"] }
      ],
      "properties": {
        "sku": { "type": "string", "minLength": 1 },
        "on_hand": { "type": "integer", "minimum": 0 },
        "in_transit": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

