{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fruktai.local/contracts/ai-explanation.input.schema.json",
  "title": "FruktAI sanitized AI explanation input",
  "type": "object",
  "additionalProperties": false,
  "required": ["recommendations"],
  "properties": {
    "recommendations": {
      "type": "array",
      "items": { "$ref": "#/$defs/explanationInputItem" }
    }
  },
  "$defs": {
    "nonNegativeNumber": { "type": "number", "minimum": 0 },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "explanationInputItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "name",
        "supplier_id",
        "supplier_name",
        "recommended_qty",
        "urgency",
        "on_hand",
        "in_transit",
        "lead_time_days",
        "avg_daily_demand",
        "forecast_demand",
        "safety_stock",
        "seasonality_factor",
        "growth_factor",
        "stockout_compensation",
        "outlier_units_removed",
        "days_of_cover",
        "deterministic_reasons"
      ],
      "properties": {
        "sku": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "supplier_id": { "type": "string", "minLength": 1 },
        "supplier_name": { "type": "string", "minLength": 1 },
        "recommended_qty": { "$ref": "#/$defs/nonNegativeInteger" },
        "urgency": { "enum": ["high", "medium", "low"] },
        "on_hand": { "$ref": "#/$defs/nonNegativeInteger" },
        "in_transit": { "$ref": "#/$defs/nonNegativeInteger" },
        "lead_time_days": { "$ref": "#/$defs/nonNegativeInteger" },
        "avg_daily_demand": { "$ref": "#/$defs/nonNegativeNumber" },
        "forecast_demand": { "$ref": "#/$defs/nonNegativeNumber" },
        "safety_stock": { "$ref": "#/$defs/nonNegativeNumber" },
        "seasonality_factor": { "$ref": "#/$defs/nonNegativeNumber" },
        "growth_factor": { "$ref": "#/$defs/nonNegativeNumber" },
        "stockout_compensation": { "$ref": "#/$defs/nonNegativeNumber" },
        "outlier_units_removed": { "$ref": "#/$defs/nonNegativeNumber" },
        "days_of_cover": { "$ref": "#/$defs/nonNegativeNumber" },
        "deterministic_reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
