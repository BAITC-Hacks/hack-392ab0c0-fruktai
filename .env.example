FRUKTAI_DATA_ROOT=data
FRUKTAI_DATABASE_PATH=artifacts/fruktai.sqlite
FRUKTAI_RUNS_DIR=artifacts/runs
FRUKTAI_SAFETY_STOCK_DAYS=7

# Optional explanation layer. Never put a real key in this example file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_EXPLANATIONS_ENABLED=false
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_EXPLANATION_ITEMS=20
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BASE_SECONDS=0.5
