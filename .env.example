# Copy these values into your local environment. Never put a real API key here.
FRUKTAI_DATA_ROOT=data
FRUKTAI_DATABASE_PATH=artifacts/fruktai.sqlite
FRUKTAI_RUNS_DIR=artifacts/runs

# Optional text-only explanation layer. Calculations do not depend on OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_EXPLANATIONS_ENABLED=false
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_EXPLANATION_ITEMS=6
